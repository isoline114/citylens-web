# API base
NEXT_PUBLIC_CITYLENS_API_BASE=http://localhost:8000

# Optional browser-safe error ingestion endpoint. Reporting is disabled when blank.
NEXT_PUBLIC_ERROR_REPORTING_DSN=

# Auth provider: 'mock' for local dev / tests, 'neon' in production.
# When 'neon', complete lib/auth/neonAuth.tsx with the real Neon Auth client and
# uncomment whichever subset of NEON_AUTH_*/STACK_* env vars your integration uses.
NEXT_PUBLIC_AUTH_PROVIDER=mock

# Neon Auth (when NEXT_PUBLIC_AUTH_PROVIDER=neon).
# These are the env vars the Vercel ↔ Neon Auth integration provisions automatically:
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_PROJECT_ID=
VITE_NEON_AUTH_URL=

# If your Neon Auth project uses Stack Auth (`@stackframe/stack`), set these instead:
# NEXT_PUBLIC_STACK_PROJECT_ID=
# NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
# STACK_SECRET_SERVER_KEY=
